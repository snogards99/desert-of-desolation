{
  "name": "Desert of Desolation Audio Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "DOD MCP Audio Development",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "cd audio-renderer && npm install && npm run check && npm test",
  "postStartCommand": "cd audio-renderer && nohup npm start > /tmp/dod-audio.log 2>&1 &"
}
