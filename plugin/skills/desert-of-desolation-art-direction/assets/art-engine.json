{
  "schema_version": 2,
  "engine_id": "dod.art-engine",
  "engine_version": "1.6.0",
  "plugin_release": "1.5.1-alpha.39",
  "theme_id": "dod.moonlit-ink",
  "modes": {
    "site": "DOD_SITE",
    "ordinary_gameplay": "DOD_PIXEL32",
    "major_presentation": "DOD_PIXEL32"
  },
  "rendering_profile": {
    "id": "dod.pixel32-rgba",
    "medium": "32_BIT_PIXEL_ART",
    "palette": "FULL_RGBA_32_BIT",
    "pixel_art": true,
    "indexed_palette_limit": null,
    "color_depth_style_constraint": "32_BIT_RGBA_PIXEL_ART_WITH_FULL_PALETTE",
    "master_resolution_policy": "PIXEL_ART_MASTER_WITH_RESPONSIVE_CRISP_DERIVATIVES",
    "scaling": "PIXEL_EDGE_PRESERVING",
    "reference_priority": [
      "EXISTING_DESERT_OF_DESOLATION_SITE_LANGUAGE",
      "I3_PHARAOH_MOOD_REFERENCE",
      "I4_I5_SUPPORTING_MOOD_REFERENCE"
    ],
    "visual_rules": [
      "32_BIT_PIXEL_ART_WITH_FULL_COLOR_PALETTE",
      "CLASSIC_ADVENTURE_MODULE_MOOD_WITHOUT_COPYING_COVER_COMPOSITION",
      "READABLE_SILHOUETTES_AND_TACTILE_EGYPTIAN_DESERT_DETAILS",
      "BELIEVABLE_DIRECTIONAL_LIGHT_WITH_RESTRAINED_SUPERNATURAL_GLOW",
      "MOBILE_READABILITY_FIRST",
      "NO_ANIME_OR_CEL_SHADING",
      "NO_GLOSSY_PHOTOREAL_CGI",
      "NO_FAKE_TEXT_OR_PSEUDO_HIEROGLYPHS"
    ]
  },
  "time_of_day": {
    "clock_source": "WorldState.total_minutes",
    "runtime_still_phases": [
      "DAY",
      "DUSK",
      "NIGHT"
    ],
    "phase_aliases": {
      "DAWN": "DUSK",
      "SUNRISE": "DUSK",
      "MORNING": "DAY",
      "EVENING": "DUSK",
      "SUNSET": "DUSK"
    },
    "perspective_policy": "CONTROLLED_VARIATION_ALLOWED_WITH_CANONICAL_GEOGRAPHY_LOCK"
  },
  "monster_profile": {
    "states": [
      "NEUTRAL",
      "ALERT",
      "ATTACK",
      "DEFEATED"
    ],
    "rules": [
      "HIDDEN_OR_HEARD_ONLY_NEVER_REVEALS_ART",
      "ATTACK_DOES_NOT_CONFIRM_HIT",
      "DEFEATED_REQUIRES_AUTHORITATIVE_OUTCOME",
      "DEFEATED_DOES_NOT_IMPLY_DEAD",
      "ONE_CANONICAL_DESIGN_ACROSS_STATES"
    ]
  },
  "treasure_profile": {
    "render_when": "DISCOVERED_AND_PLAYER_VISIBLE",
    "rules": [
      "ONE_STABLE_ITEM_ART_ID_PER_UNIQUE_ITEM",
      "DO_NOT_PRELOAD_OR_RENDER_BEFORE_DISCOVERY",
      "UNKNOWN_MAGIC_PROPERTIES_MUST_NOT_BE_VISUALLY_DISCLOSED"
    ]
  },
  "runtime_rules": {
    "presentation_does_not_advance_state": true,
    "audio_engine_ownership": "EXISTING_GAME_AUDIO_ENGINE",
    "fail_closed_on_hidden_or_unapproved_art": true,
    "predictive_preload": "CURRENT_PLUS_ONE_LIKELY_PLUS_TWO_PLAYER_SAFE_ALTERNATES_MAX",
    "preload_all_time_variants": false,
    "preload_all_monster_states": false,
    "preload_undiscovered_treasure": false
  }
}
